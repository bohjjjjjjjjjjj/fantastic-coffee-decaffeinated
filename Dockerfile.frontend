# syntax=docker/dockerfile:1

# ---- build stage -----------------------------------------------------------
FROM node:20-bookworm AS builder

WORKDIR /app

# Installazione deterministica dal lockfile committato.
COPY webui/package.json webui/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY webui/ ./

# Build di produzione. __API_URL__ è iniettata da vite.config.js
# (http://localhost:3000) ed è usata in fase di valutazione: non modificarla.
RUN npx vite build --mode production

# ---- runtime stage -------------------------------------------------------
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY webui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -qO- http://localhost/healthz || exit 1
